{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "PY=/usr/bin/python3; [ -x \"$PY\" ] || PY=python; \"$PY\" \"${CLAUDE_PROJECT_DIR}/tools/guard/pretooluse.py\""
          }
        ]
      }
    ]
  }
}
